{
  "manifest_version": 3,
  "name": "Untab Pomodoro Tab History",
  "version": "1.0",
  "description": "Closes the current tab after a set timer to help manage media consumption.",
  "permissions": ["tabs", "alarms", "storage", "notifications"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/untab-white.png",
      "48": "icons/untab-white.png",
      "128": "icons/untab-white.png"
    }
  },
  "icons": {
    "16": "icons/untab-white.png",
    "48": "icons/untab-white.png",
    "128": "icons/untab-white.png"
  }
}
